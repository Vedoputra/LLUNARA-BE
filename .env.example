# Server
PORT=8080
ENV=development
ALLOWED_ORIGINS=

# Supabase (lihat BE-1.1 — diisi setelah project Supabase dibuat)
# Gunakan connection string dari connection pooler, bukan direct connection.
DATABASE_URL=
SUPABASE_URL=

# Project Supabase baru memakai JWT signing key asimetris secara default.
# Nilai ini datang dari Project Settings → API → JWT Settings → "Legacy JWT Secret"
# (harus diaktifkan dulu kalau belum terlihat). Tanpa ini, verifikasi JWT HS256 di BE-2.2 tidak bisa jalan.
SUPABASE_JWT_SECRET=

# Nama baru dari Supabase untuk apa yang dulu disebut "service_role key" — tetap
# mem-bypass RLS. Hanya untuk operasi admin (mis. hapus akun di BE-6.4). TIDAK PERNAH dipakai di frontend.
SUPABASE_SECRET_KEY=
